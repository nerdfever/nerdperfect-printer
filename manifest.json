{
  "manifest_version": 3,
  "name": "NerdPerfect Printer",
  "version": "1.0.11.1",
  "version_name": "1.11.1",
  "homepage_url": "https://nerdfever.com/introducing-nerdperfect-printer/",
  "author": "nerdfever.com",
  "description": "Clean prints of web pages, esp. articles. No text clipping, ads and overlays removed from print. All local - nothing collected.",

  "permissions": ["activeTab", "contextMenus", "scripting", "storage"],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "NerdPerfect Printer",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
