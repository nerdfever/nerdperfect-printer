{
  "manifest_version": 3,
  "name": "NerdPerfect Printer",
  "version": "1.0.1",
  "version_name": "1.01",
  "homepage_url": "https://nerdfever.com",
  "author": "nerdfever.com",
  "description": "Clean, readable printouts of web articles. Extracts the article, reflows it into a print-optimized layout, and prints — no clipped text, no ads, no overlays. All processing is local.",

  "permissions": ["activeTab", "contextMenus", "scripting", "storage"],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "NerdPerfect Printer",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
